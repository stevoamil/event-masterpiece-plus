# --- Database ---
# Local dev uses SQLite (zero setup). For production, provision a hosted
# Postgres instance (Neon/Supabase/Vercel Postgres), set DATABASE_URL to its
# connection string, change `provider = "sqlite"` to `"postgresql"` in
# prisma/schema.prisma, then run `npx prisma migrate deploy`.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Signs session JWTs. Generate a strong random value for production, e.g.
# `openssl rand -base64 32`.
AUTH_SECRET=""

# --- AI Assistant (Google Gemini API) ---
# Required for the concierge chat widget to respond with real AI answers.
# Get a free key at https://aistudio.google.com/apikey — never expose this client-side.
GEMINI_API_KEY=""

# --- Photo Storage (Vercel Blob) ---
# Required for uploading gallery photos in the admin dashboard. Create a Blob
# store in the Vercel dashboard (Storage tab) and connect it to this project —
# Vercel injects this automatically once connected. Locally, run `vercel env
# pull` after connecting, or grab the token from Storage → your store → .env.local tab.
BLOB_READ_WRITE_TOKEN=""

# --- WhatsApp Business Platform (Meta) ---
# The "Chat on WhatsApp" buttons work without these (they use wa.me links).
# These are only needed for two-way sync into the admin WhatsApp inbox.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

NEXT_PUBLIC_WHATSAPP_NUMBER="33682152387"

# --- Email Notifications (Resend) ---
# Optional. When set, the admin is emailed whenever the AI concierge books a
# consultation (also requires "Email me when a consultation is booked" to be
# enabled in Admin → Settings). Get a key at https://resend.com/.
RESEND_API_KEY=""
